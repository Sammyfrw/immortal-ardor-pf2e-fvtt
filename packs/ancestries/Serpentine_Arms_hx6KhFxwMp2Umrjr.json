  "system": {
    "description": {
      "gm": "",
      "value": "<p class=\"MsoNormal\"><span style=\"mso-bidi-font-size:12.0pt;mso-bidi-font-family:Calibri;mso-bidi-theme-font:minor-latin\">Your body is a deadly weapon of its own. origins grant you powerful natural weapons. When you select this feat, you gain your choice of either a tail unarmed attack or improve your fangs unarmed attack. These attacks are in the Brawling </span>weapon group.</p><ul><li><p class=\"MsoListParagraphCxSpFirst\">Tail, 1d6 bludgeoning [grapple, trip, unarmed]</p></li><li><p class=\"MsoListParagraphCxSpLast\">Improved Fangs, 1d8 piercing [finesse, grapple, unarmed]</p></li></ul><p class=\"MsoNormal\"><span style=\"mso-bidi-font-size:12.0pt;mso-bidi-font-family:Calibri;mso-bidi-theme-font:minor-latin\">At 5th level, whenever you get a critical hit with one of these attacks, you get its critical specialization effect.</span></p><p class=\"MsoNormal\"><span style=\"text-decoration:underline\"><span style=\"text-decoration:underline\">Special</span></span><span style=\"mso-bidi-font-size:12.0pt;mso-bidi-font-family:Calibri;mso-bidi-theme-font:minor-latin\"> You can take this feat a number of times equal to the attacks listed above. Each time you do, select a different attack.</span></p>"
    },
