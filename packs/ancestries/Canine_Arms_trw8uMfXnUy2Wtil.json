  "system": {
    "description": {
      "gm": "",
      "value": "<p class=\"MsoNormal\"><span style=\"mso-bidi-font-size:12.0pt;mso-bidi-font-family:Calibri;mso-bidi-theme-font:minor-latin\">Your fangs and claws are sharp weapons. When you select this feat, you gain either a claw or a fangs unarmed attack. These attacks are in the Brawling weapon group.</span></p><ul><li><p class=\"MsoListParagraphCxSpFirst\">Claws, 1d4 slashing [agile, finesse, grapple, unarmed]</p></li><li><p class=\"MsoListParagraphCxSpLast\">Fangs, 1d6 piercing [finesse, trip, unarmed]</p></li></ul><p class=\"MsoNormal\"><span style=\"mso-bidi-font-size:12.0pt;mso-bidi-font-family:Calibri;mso-bidi-theme-font:minor-latin\">At 5th level, whenever you get a critical hit with one of these attacks, you get its critical specialization effect.</span></p><p class=\"MsoNormal\"><span style=\"mso-bidi-font-size:12.0pt;mso-bidi-font-family:Calibri;mso-bidi-theme-font:minor-latin\"><span style=\"text-decoration:underline\">Special</span></span><span style=\"mso-bidi-font-size:12.0pt;mso-bidi-font-family:Calibri;mso-bidi-theme-font:minor-latin\"> You can take this feat a number of times equal to the attacks listed above. Each time you do, select a different attack.</span></p>"
    },
