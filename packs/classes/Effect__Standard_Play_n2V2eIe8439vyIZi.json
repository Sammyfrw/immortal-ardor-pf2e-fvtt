  "system": {
    "description": {
      "gm": "",
      "value": "<p>Granted by @UUID[Compendium.immortal-ardor.classes.k9UB3L2ddh2b03Wb]{Standard Play}</p><p>You gain a status bonus effect for 1 round, depending on the suit played.</p><ul><li><p class=\"MsoNormal\"><strong>Strength</strong>: You adds a bonus to damage rolls equal to half your level rounded down. For damage to multiple targets or in an area, select only one target for this extra damage.</p></li><li><p class=\"MsoNormal\"><strong>Dexterity</strong>: You add a bonus to attack rolls.</p></li><li><p class=\"MsoNormal\"><strong>Constitution</strong>: You add a bonus to AC.</p></li><li><p class=\"MsoNormal\"><strong>Intelligence</strong>: You add a bonus to spell DCs and class DCs.</p></li><li><p class=\"MsoNormal\"><strong>Wisdom</strong>: You add a bonus to Perception checks and saving throws.</p></li><li><p class=\"MsoNormal\"><span style=\"color:black\"><strong>Charisma: </strong></span>You add a bonus<span style=\"color:black\"> to all skill checks and DCs.</span></p></li></ul>"
    },
