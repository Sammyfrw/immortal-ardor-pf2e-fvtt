  "system": {
    "description": {
      "gm": "",
      "value": "<p class=\"MsoNormal\"><span style=\"mso-bidi-font-size:12.0pt;mso-bidi-font-family:Calibri;mso-bidi-theme-font:minor-latin\">Your body may have fewer physical features of your benefactor, but internally you harbor a powerful affiliation to them. You gain resistance equal to half your level to effects with the trait you selected from your benefactor, and when you roll a success on a saving throw against an effect with that trait, you critically succeed instead. If you have multiple traits selected, choose one.</span></p><p class=\"MsoNormal\"><span style=\"text-decoration:underline\"><span style=\"text-decoration:underline\">Special</span></span><span style=\"mso-bidi-font-size:12.0pt;mso-bidi-font-family:Calibri;mso-bidi-theme-font:minor-latin\"> If you are Draichsar with the Draich heritage, you also gain the @UUID[Compendium.immortal-ardor.ancestries.NlGzXdfbf3IsupSJ]{Exemplary Qualities} Draichsar ancestry feat for the same trait you use for this feat.</span></p>"
    },
